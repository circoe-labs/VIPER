# Copy to deploy/.env on the server (chmod 600). Never commit the real file.
VIPER_DOMAIN=viper.circoe.com
POSTGRES_PASSWORD=change-me
SQL_READER_PASSWORD=change-me-too
# Infomaniak OpenID Connect app (Manager › Développeur › OAuth). Redirect URI:
# https://<VIPER_DOMAIN>/api/auth/infomaniak/callback. Empty = password sign-in stays.
INFOMANIAK_CLIENT_ID=
INFOMANIAK_CLIENT_SECRET=
