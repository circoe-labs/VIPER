# Copy to backend/.env to override defaults. Never commit .env (it is git-ignored).
# Defaults below match docker-compose.yml (local development credentials only).
VIPER_DATABASE_URL=postgresql+psycopg://viper:viper@127.0.0.1:5442/viper
# Used by pytest and `alembic -x db=test ...`. The database name must end with `_test`.
VIPER_TEST_DATABASE_URL=postgresql+psycopg://viper:viper@127.0.0.1:5442/viper_test

# Authentication (ADR-0004). No password or secret is configured here: create the login account
# with `python -m app.cli create-user --email ... --display-name ...` (prompts for the password).
# Keep `Secure` on (browsers accept it on http://localhost); set false only for plain-HTTP access
# through another host name.
VIPER_SESSION_COOKIE_SECURE=true
VIPER_SESSION_IDLE_TIMEOUT_MINUTES=120
VIPER_SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# Read-only SQL console (ADR-0011): role created/aligned by `python -m app.cli provision-sql-reader`.
# The password default is a local-development value; set your own secret outside local development.
VIPER_SQL_READER_ROLE=viper_sql_reader
# VIPER_SQL_READER_PASSWORD=<secret>
VIPER_SQL_STATEMENT_TIMEOUT_MS=5000
VIPER_SQL_MAX_ROWS=1000

# Excel/CSV import bounds (ADR-0007): file size in MiB, non-empty rows and columns per sheet.
VIPER_IMPORT_MAX_FILE_MB=10
VIPER_IMPORT_MAX_ROWS=5000
VIPER_IMPORT_MAX_COLUMNS=100

# Prospection (Task 14): an employment verification older than this many days counts as « À revérifier ».
# Unset by default: product has not chosen the threshold (open question #9).
# VIPER_VERIFICATION_STALE_DAYS=<days>

# Home (Task 16): informative monthly targets (prospects newly contacted, appointments obtained).
VIPER_MONTHLY_CONTACT_TARGET=100
VIPER_MONTHLY_APPOINTMENT_TARGET=10

# Contact messages (S3): sender pre-filled in a new Contact/R1/R2 message. Unset: typed by hand.
# VIPER_DEFAULT_OUTBOUND_EMAIL=<adresse d'envoi>

# AI drafting of Contact messages (S5). Key and model are both required (no default model: choose it);
# unset, « Générer avec l'IA » is disabled and the API answers 503 `ai_not_configured`. Server side only:
# the key never reaches the browser and is never logged. Tests and E2E use a local fake server only.
# VIPER_OPENAI_API_KEY=<secret>
# VIPER_OPENAI_MODEL=<model id>
# VIPER_OPENAI_BASE_URL=https://api.openai.com/v1
# Per network operation (each read/write; connect ≤ 10 s), not a total per attempt.
# VIPER_OPENAI_TIMEOUT_MS=60000
# VIPER_OPENAI_MAX_RETRIES=2
# true: honour HTTPS_PROXY / NO_PROXY / SSL_CERT_FILE of the server (corporate proxy or CA).
# VIPER_OPENAI_TRUST_ENV=false
# Booking link the AI may copy into a mail (http/https); unset = no link at all.
# VIPER_CONTACT_BOOKING_URL=<https://…>

# CIRCOE Toolbox (S6): Infomaniak drafts of validated Contact messages through the Toolbox MCP server.
# Off by default: everything stays in VIPER. Enabled with both URLs, connect from Paramètres > Connexions (OAuth 2.1 +
# PKCE: the Toolbox signs you in at Infomaniak and asks for a personal Infomaniak API token with the Mail scope).
# The real sender is the default mailbox of that Infomaniak account (VIPER's « De » is not transmitted).
# VIPER_TOOLBOX_MAIL_ENABLED=false
# Exact MCP URL announced by the Toolbox (https, or http on localhost only).
# VIPER_TOOLBOX_MCP_URL=https://circoetoolbox-server-production.up.railway.app/mcp
# The SPA page the Toolbox sends the browser back to, as the browser sees it (https, or http on localhost only).
# VIPER_TOOLBOX_OAUTH_REDIRECT_URI=http://localhost:5173/settings/connections
# OAuth token file: outside the database and outside this checkout (refused inside it). Default ~/.viper/toolbox-oauth.json
# VIPER_TOOLBOX_TOKEN_STORE_PATH=
# Total bound of one Toolbox operation in ms (1000-120000).
# VIPER_TOOLBOX_TIMEOUT_MS=20000
# Period of the obsolete-draft cleanup worker in ms; 0 = no worker (run `python -m app.cli toolbox-cleanup --once`).
# VIPER_TOOLBOX_CLEANUP_INTERVAL_MS=60000
# Optional VIPER-side recipient allowlist of the scheduled send (S7): addresses or @domain, comma-separated.
# VIPER_INFOMANIAK_SEND_ALLOWLIST=
