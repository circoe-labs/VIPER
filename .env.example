PORT=3001
# Dossier persistant, indépendant du checkout Git. Laisser vide pour utiliser ~/.viper
VIPER_STORAGE_DIR=
# Optionnel : surcharge complète du chemin SQLite
# VIPER_DB_PATH=/chemin/persistant/viper.sqlite
VIPER_USER_EMAIL=commercial@example.test
VIPER_USER_PASSWORD=change-me-now
SESSION_SECRET=replace-with-a-long-random-secret
# Adresse From préremplie des messages Contact/R1/R2 (jamais codée en dur ; vide = à saisir dans l'éditeur)
DEFAULT_OUTBOUND_EMAIL=
