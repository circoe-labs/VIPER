PORT=3001
# Dossier persistant, indépendant du checkout Git. Laisser vide pour utiliser ~/.viper
VIPER_STORAGE_DIR=
# Optionnel : surcharge complète du chemin SQLite
# VIPER_DB_PATH=/chemin/persistant/viper.sqlite
VIPER_USER_EMAIL=commercial@example.test
VIPER_USER_PASSWORD=change-me-now
SESSION_SECRET=replace-with-a-long-random-secret
# Adresse From préremplie des messages Contact/R1/R2 (jamais codée en dur ; vide = à saisir dans l'éditeur)
DEFAULT_OUTBOUND_EMAIL=
# Génération IA des messages Contact/R1/R2 (serveur uniquement, jamais exposé au navigateur).
# Clé et modèle obligatoires pour activer « Générer » (vides = génération désactivée, erreur explicite ai_not_configured).
# Aucun modèle par défaut : renseigner un identifiant de modèle de l'API Responses d'OpenAI vérifié dans la doc officielle.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optionnels : URL de base de l'API (défaut https://api.openai.com/v1), délai par tentative en ms (défaut 60000),
# nombre de nouvelles tentatives sur erreur transitoire 429/5xx/réseau (défaut 2, max 5).
# OPENAI_BASE_URL=
# OPENAI_TIMEOUT_MS=60000
# OPENAI_MAX_RETRIES=2
# Optionnel : lien de prise de rendez-vous inséré par l'IA (vide = aucun lien proposé, jamais inventé).
CONTACT_BOOKING_URL=
