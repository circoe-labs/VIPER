PORT=3001
# Dossier persistant, indépendant du checkout Git. Laisser vide pour utiliser ~/.viper
VIPER_STORAGE_DIR=
# Optionnel : surcharge complète du chemin SQLite
# VIPER_DB_PATH=/chemin/persistant/viper.sqlite
VIPER_USER_EMAIL=commercial@example.test
VIPER_USER_PASSWORD=change-me-now
SESSION_SECRET=replace-with-a-long-random-secret
# Adresse From préremplie des messages Contact/R1/R2 (jamais codée en dur ; vide = à saisir dans l'éditeur)
DEFAULT_OUTBOUND_EMAIL=
# Génération IA des messages Contact/R1/R2 (serveur uniquement, jamais exposé au navigateur).
# Clé et modèle obligatoires pour activer « Générer » (vides = génération désactivée, erreur explicite ai_not_configured).
# Aucun modèle par défaut : renseigner un identifiant de modèle de l'API Responses d'OpenAI vérifié dans la doc officielle.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optionnels : URL de base de l'API (défaut https://api.openai.com/v1), délai par tentative en ms (défaut 60000),
# nombre de nouvelles tentatives sur erreur transitoire 429/5xx/réseau (défaut 2, max 5).
# OPENAI_BASE_URL=
# OPENAI_TIMEOUT_MS=60000
# OPENAI_MAX_RETRIES=2
# Optionnel : lien de prise de rendez-vous inséré par l'IA (vide = aucun lien proposé, jamais inventé).
CONTACT_BOOKING_URL=
# CIRCOE Toolbox (brouillons Infomaniak des messages validés) — désactivée par défaut ; aucune valeur secrète ici.
# Activée + configurée + connectée (Paramètres > « Connecter la Toolbox », OAuth 2.1 + PKCE avec la Toolbox, qui demande la connexion
# Infomaniak puis un token API personnel Mail) : chaque validation crée un brouillon dans la boîte liée au token (expéditeur réel,
# DEFAULT_OUTBOUND_EMAIL n'est pas transmis) ; une édition/annulation le met en file de suppression. Aucun envoi automatique (Task 16).
TOOLBOX_MAIL_ENABLED=false
# URL MCP exacte (ressource OAuth annoncée par la Toolbox), HTTPS ou http://localhost.
# TOOLBOX_MCP_URL=https://circoetoolbox-server-production.up.railway.app/mcp
TOOLBOX_MCP_URL=
# URI de retour OAuth vers l'API VIPER, telle que vue par le navigateur (HTTPS, ou http://localhost / 127.0.0.1 seulement).
# En dev derrière Vite : http://localhost:5173/api/toolbox/oauth/callback
TOOLBOX_OAUTH_REDIRECT_URI=
# Optionnels : fichier des jetons (défaut <VIPER_STORAGE_DIR>/toolbox-oauth.json, jamais dans le dépôt ni la base SQLite),
# délai par requête Toolbox en ms (défaut 20000), période du worker de suppression des brouillons obsolètes en ms (défaut 60000, 0 = arrêt).
# TOOLBOX_TOKEN_STORE_PATH=
# TOOLBOX_TIMEOUT_MS=20000
# TOOLBOX_CLEANUP_INTERVAL_MS=60000
